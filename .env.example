# Google OAuth 2.0 Credentials
# Obtain these from: https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Web Application)
# 2. Add Authorized redirect URIs:
#    http://localhost:4321/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/google/callback

# Public client ID for Google Identity Services (optional, for Google One Tap)
PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Application Secret
JWT_SECRET=task-flow-super-secure-production-jwt-secret-key-32chars!

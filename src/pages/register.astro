---
import Layout from '../layouts/Layout.astro';

if (Astro.locals.user) {
  return Astro.redirect('/dashboard');
}

const url = new URL(Astro.request.url);
const initialError = url.searchParams.get('error') || '';
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || process.env.GOOGLE_CLIENT_ID || '';
---

<Layout title="Sign Up - TaskFlow" activePath="/register">
  <div class="min-h-[85vh] flex items-center justify-center p-4 relative">
    {/* Ambient Glows */}
    <div class="absolute top-1/4 left-1/3 w-80 h-80 bg-blue-500/10 dark:bg-blue-600/15 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute bottom-1/4 right-1/3 w-80 h-80 bg-purple-500/10 dark:bg-purple-600/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="w-full max-w-sm bg-white dark:bg-[#111827] border border-slate-200/90 dark:border-slate-800 rounded-3xl p-7 sm:p-8 shadow-2xl shadow-slate-900/10 relative transition-all">
      <div class="text-center mb-6">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-indigo-600/30 mx-auto mb-3.5">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
        </div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">Create your account</h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-medium">Get started with TaskFlow in seconds</p>
      </div>

      <!-- Error Alert -->
      <div
        id="errorAlert"
        class={`mb-4 p-3 rounded-xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-900/60 text-rose-600 dark:text-rose-400 text-xs font-semibold leading-relaxed ${
          initialError ? '' : 'hidden'
        }`}
      >
        {initialError}
      </div>

      <!-- Success Alert -->
      <div id="successAlert" class="hidden mb-4 p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-900/60 text-emerald-600 dark:text-emerald-400 text-xs font-semibold"></div>

      <!-- REAL GOOGLE SIGN UP LINK -->
      <div class="space-y-3.5">
        <a
          href="/api/auth/google/signin"
          id="googleRegisterBtn"
          class="w-full py-2.5 px-4 rounded-xl bg-white dark:bg-[#18233c] hover:bg-slate-50 dark:hover:bg-[#1e2c4b] active:scale-98 border border-slate-200/90 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 font-bold text-xs shadow-xs hover:shadow-md transition-all cursor-pointer flex items-center justify-center gap-2.5 text-center"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
          <span id="googleBtnText">Sign up with Google</span>
        </a>

        <!-- Divider -->
        <div class="relative flex items-center justify-center my-4">
          <div class="border-t border-slate-200 dark:border-slate-800 w-full"></div>
          <span class="bg-white dark:bg-[#111827] px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 shrink-0">
            or with email
          </span>
          <div class="border-t border-slate-200 dark:border-slate-800 w-full"></div>
        </div>

        <form id="registerForm" class="space-y-3.5">
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Full Name</label>
            <input
              type="text"
              id="name"
              required
              placeholder="Maya Lin"
              class="w-full bg-slate-50 dark:bg-[#18233c] border border-slate-200 dark:border-slate-700/80 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-blue-600 transition-all font-medium"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Email address</label>
            <input
              type="email"
              id="email"
              required
              placeholder="maya@acme.com"
              class="w-full bg-slate-50 dark:bg-[#18233c] border border-slate-200 dark:border-slate-700/80 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-blue-600 transition-all font-medium"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Password</label>
            <input
              type="password"
              id="password"
              required
              minlength="6"
              placeholder="At least 6 characters"
              class="w-full bg-slate-50 dark:bg-[#18233c] border border-slate-200 dark:border-slate-700/80 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-blue-600 transition-all font-medium"
            />
          </div>

          <button
            type="submit"
            id="submitBtn"
            class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 active:scale-98 text-white font-bold text-xs shadow-md shadow-blue-600/25 transition-all cursor-pointer flex items-center justify-center gap-2 mt-2"
          >
            <span id="submitBtnText">Create Free Account</span>
          </button>
        </form>
      </div>

      <p class="text-center text-xs text-slate-500 dark:text-slate-400 mt-5 font-medium">
        Already have an account?{' '}
        <a href="/login" class="text-blue-600 dark:text-blue-400 hover:underline font-bold transition-colors">
          Sign In
        </a>
      </p>
    </div>
  </div>

  <script>
    const form = document.getElementById('registerForm');
    const errorAlert = document.getElementById('errorAlert');
    const successAlert = document.getElementById('successAlert');
    const submitBtn = document.getElementById('submitBtn');
    const submitBtnText = document.getElementById('submitBtnText');

    function showError(msg) {
      if (errorAlert) {
        errorAlert.textContent = msg;
        errorAlert.classList.remove('hidden');
      }
      if (successAlert) successAlert.classList.add('hidden');
    }

    function showSuccess(msg) {
      if (successAlert) {
        successAlert.textContent = msg;
        successAlert.classList.remove('hidden');
      }
      if (errorAlert) errorAlert.classList.add('hidden');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorAlert) errorAlert.classList.add('hidden');
      if (submitBtn) submitBtn.setAttribute('disabled', 'true');
      if (submitBtnText) submitBtnText.textContent = 'Creating account...';

      const name = document.getElementById('name').value;
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, password }),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'Failed to register');
        }

        showSuccess('Account created! Redirecting to company setup...');
        window.location.href = '/company/create';
      } catch (err) {
        showError(err.message || 'Registration failed');
      } finally {
        if (submitBtn) submitBtn.removeAttribute('disabled');
        if (submitBtnText) submitBtnText.textContent = 'Create Free Account';
      }
    });
  </script>
</Layout>

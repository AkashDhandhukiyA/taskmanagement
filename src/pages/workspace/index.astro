---
import Layout from '../../layouts/Layout.astro';
import WorkspaceManager from '../../components/workspace/WorkspaceManager';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}
---

<Layout title="Workspaces & Team - Acme Corp" activePath="/workspace">
  <div class="space-y-6 max-w-7xl mx-auto px-4 md:px-6 py-4">
    <div class="flex items-center justify-between pb-3 border-b border-slate-200/80">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">Workspaces & Team Members</h1>
        <p class="text-xs text-slate-500 font-medium mt-1">Manage team access, workspace ownership, and roles</p>
      </div>
    </div>

    <WorkspaceManager client:load />
  </div>
</Layout>

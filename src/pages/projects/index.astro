---
import Layout from '../../layouts/Layout.astro';
import ProjectList from '../../components/project/ProjectList';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}
---

<Layout title="Projects - Acme Corp" activePath="/projects">
  <div class="space-y-6 w-full max-w-full px-4 md:px-6 py-4">
    <div class="flex items-center justify-between pb-3 border-b border-slate-200/80">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">Projects</h1>
        <p class="text-xs text-slate-500 font-medium mt-1">Organize your tasks into projects, track completion rates, and milestones</p>
      </div>
    </div>

    <ProjectList client:load />
  </div>
</Layout>

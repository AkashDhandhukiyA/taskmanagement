---
import Layout from '../layouts/Layout.astro';

const user = Astro.locals.user;
---

<Layout title="Acme Corp - TaskFlow & Sprint Management" activePath="/">
  <div class="relative overflow-hidden pt-12 pb-24">
    <!-- Subtle Background Glows -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-blue-400/10 blur-[130px] pointer-events-none rounded-full"></div>
    <div class="absolute top-1/3 left-1/4 w-[400px] h-[250px] bg-indigo-300/10 blur-[120px] pointer-events-none rounded-full"></div>

    <div class="max-w-5xl mx-auto px-6 text-center relative z-10">
      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-slate-900 max-w-4xl mx-auto leading-tight sm:leading-tight">
        Sprints & Tasks at <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Optimal Velocity</span>
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-500 max-w-2xl mx-auto font-medium leading-relaxed">
        Engineered for agile teams with Astro 5, Drizzle ORM, and Cloudflare D1. Complete with interactive Kanban boards, role-based company teams, timezone intelligence, analytics, and edge JWT authentication.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
        {user ? (
          <a
            href="/dashboard"
            class="px-6 py-3 rounded-2xl bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-bold text-sm shadow-lg shadow-blue-600/30 transition-all flex items-center gap-2"
          >
            Go to Your Dashboard
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        ) : (
          <>
            <a
              href="/register"
              class="px-6 py-3 rounded-2xl bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-bold text-sm shadow-lg shadow-blue-600/30 transition-all flex items-center gap-2"
            >
              Get Started Free
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
            <a
              href="/login"
              class="px-6 py-3 rounded-2xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-bold text-sm shadow-2xs transition-all"
            >
              Sign In to Account
            </a>
          </>
        )}
      </div>

      <!-- Feature Highlights Grid -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
        <div class="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-xs">
          <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg mb-4 font-bold">
            📋
          </div>
          <h3 class="font-black text-base text-slate-900">Interactive Kanban Board</h3>
          <p class="mt-2 text-xs text-slate-500 font-medium leading-relaxed">
            Drag, organize, and filter tasks across To-Do, In-Progress, Review, and Done lanes with real-time optimistic UI updates.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-xs">
          <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg mb-4 font-bold">
            ⚡
          </div>
          <h3 class="font-black text-base text-slate-900">Cloudflare D1 & Drizzle</h3>
          <p class="mt-2 text-xs text-slate-500 font-medium leading-relaxed">
            Distributed SQLite database at Cloudflare edge with sub-millisecond query performance and fully type-safe Drizzle migrations.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-xs">
          <div class="w-10 h-10 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg mb-4 font-bold">
            🛡️
          </div>
          <h3 class="font-black text-base text-slate-900">Company Pulse Analytics</h3>
          <p class="mt-2 text-xs text-slate-500 font-medium leading-relaxed">
            Real-time velocity tracking, circular sprint meters, upcoming deadline alerts, and live team activity feeds.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

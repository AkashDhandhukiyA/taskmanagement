---
import Layout from '../../layouts/Layout.astro';
import TaskBoard from '../../components/task/TaskBoard';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}
---

<Layout title="Tasks & Kanban - Acme Corp" activePath="/tasks">
  <div class="space-y-4 sm:space-y-6 w-full max-w-full px-3 sm:px-4 md:px-6 py-3 sm:py-4 min-w-0">
    <!-- Interactive TaskBoard React Island with drag-and-drop -->
    <TaskBoard client:only="react" />
  </div>
</Layout>

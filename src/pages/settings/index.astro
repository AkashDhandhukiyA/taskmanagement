---
import Layout from '../../layouts/Layout.astro';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}
---

<Layout title="Account Settings - Acme Corp" activePath="/settings">
  <div class="space-y-6 max-w-4xl mx-auto px-4 md:px-6 py-4">
    <div class="pb-3 border-b border-slate-200/80">
      <h1 class="text-2xl font-black text-slate-900 tracking-tight">Account & Security Settings</h1>
      <p class="text-xs text-slate-500 font-medium mt-1">Manage your credentials, preferences, and session tokens</p>
    </div>

    <div class="grid grid-cols-1 gap-6">
      <!-- ==================== Profile Card ==================== -->
      <div class="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-xs space-y-5">
        <h3 class="font-black text-sm text-slate-900">Personal Profile</h3>

        <div class="flex items-center gap-4">
          <div class="w-16 h-16 rounded-2xl bg-blue-50 border border-blue-200 flex items-center justify-center font-black text-blue-600 text-2xl">
            {user.name ? user.name[0].toUpperCase() : 'U'}
          </div>
          <div>
            <p class="text-base font-black text-slate-900">{user.name}</p>
            <p class="text-xs text-slate-500 font-medium">{user.email}</p>
            <span class="inline-block mt-2 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
              Active Cloudflare Session
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-100">
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-xs font-bold text-slate-700">Your User ID (Share to get invited)</label>
              <button
                type="button"
                id="copyUserIdBtn"
                class="text-[10px] font-bold text-blue-600 hover:text-blue-700 cursor-pointer flex items-center gap-1"
              >
                📋 Copy ID
              </button>
            </div>
            <input
              type="text"
              id="userIdInput"
              readonly
              value={user.id || user.userId}
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-700 font-mono select-all cursor-pointer"
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Email</label>
            <input
              type="text"
              readonly
              value={user.email}
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-600 font-mono"
            />
          </div>
        </div>
      </div>

      <!-- ==================== Appearance ==================== -->
      <div class="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-xs space-y-5">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-black text-sm text-slate-900">Appearance</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Personalize how TaskFlow looks on this device</p>
          </div>
          <span class="px-2 py-0.5 rounded-md bg-violet-50 text-[10px] font-bold text-violet-600 border border-violet-200">
            Device-only
          </span>
        </div>

        <!-- Theme picker -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-2">Theme</label>
          <div class="grid grid-cols-3 gap-2">
            <button
              type="button"
              data-theme="light"
              class="theme-btn group p-3 rounded-2xl border-2 border-slate-200 hover:border-blue-400 transition-all cursor-pointer text-left"
            >
              <div class="w-full h-10 rounded-lg bg-white border border-slate-200 mb-2 flex items-center justify-center">
                <div class="w-6 h-1.5 rounded-full bg-slate-300"></div>
              </div>
              <p class="text-xs font-bold text-slate-800">Light</p>
            </button>
            <button
              type="button"
              data-theme="dark"
              class="theme-btn group p-3 rounded-2xl border-2 border-slate-200 hover:border-blue-400 transition-all cursor-pointer text-left"
            >
              <div class="w-full h-10 rounded-lg bg-slate-900 border border-slate-700 mb-2 flex items-center justify-center">
                <div class="w-6 h-1.5 rounded-full bg-slate-600"></div>
              </div>
              <p class="text-xs font-bold text-slate-800">Dark</p>
            </button>
            <button
              type="button"
              data-theme="system"
              class="theme-btn group p-3 rounded-2xl border-2 border-slate-200 hover:border-blue-400 transition-all cursor-pointer text-left"
            >
              <div class="w-full h-10 rounded-lg bg-gradient-to-r from-white to-slate-900 border border-slate-200 mb-2 flex items-center justify-center">
                <div class="w-6 h-1.5 rounded-full bg-gradient-to-r from-slate-300 to-slate-600"></div>
              </div>
              <p class="text-xs font-bold text-slate-800">System</p>
            </button>
          </div>
        </div>

        <!-- Accent color -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-2">Accent Color</label>
          <div class="flex items-center gap-2" id="accentPicker">
            <button type="button" data-accent="#2563eb" class="accent-btn w-8 h-8 rounded-full border-2 border-white shadow-sm cursor-pointer" style="background:#2563eb" title="Blue"></button>
            <button type="button" data-accent="#7c3aed" class="accent-btn w-8 h-8 rounded-full border-2 border-white shadow-sm cursor-pointer" style="background:#7c3aed" title="Violet"></button>
            <button type="button" data-accent="#059669" class="accent-btn w-8 h-8 rounded-full border-2 border-white shadow-sm cursor-pointer" style="background:#059669" title="Emerald"></button>
            <button type="button" data-accent="#e11d48" class="accent-btn w-8 h-8 rounded-full border-2 border-white shadow-sm cursor-pointer" style="background:#e11d48" title="Rose"></button>
            <button type="button" data-accent="#ea580c" class="accent-btn w-8 h-8 rounded-full border-2 border-white shadow-sm cursor-pointer" style="background:#ea580c" title="Orange"></button>
            <button type="button" data-accent="#0891b2" class="accent-btn w-8 h-8 rounded-full border-2 border-white shadow-sm cursor-pointer" style="background:#0891b2" title="Cyan"></button>
          </div>
        </div>

        <!-- Density -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-2">Layout Density</label>
          <div class="flex items-center bg-slate-100 p-1 rounded-xl w-fit">
            <button type="button" data-density="compact" class="density-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer">Compact</button>
            <button type="button" data-density="cozy" class="density-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer">Cozy</button>
            <button type="button" data-density="comfortable" class="density-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer">Comfortable</button>
          </div>
        </div>
      </div>

      <!-- ==================== Notifications ==================== -->
      <div class="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-xs space-y-5">
        <div>
          <h3 class="font-black text-sm text-slate-900">Notifications</h3>
          <p class="text-[11px] text-slate-400 mt-0.5">Choose what you'd like to be notified about</p>
        </div>

        <div class="space-y-1">
          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors">
            <div>
              <p class="text-xs font-bold text-slate-800">Task assignments</p>
              <p class="text-[10px] text-slate-400 font-medium">When someone assigns a task to you</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer notif-toggle" data-key="notif.taskAssigned" checked />
              <div class="w-9 h-5 bg-slate-200 peer-checked:bg-blue-600 rounded-full transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-4"></div>
            </label>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors">
            <div>
              <p class="text-xs font-bold text-slate-800">Comments & mentions</p>
              <p class="text-[10px] text-slate-400 font-medium">When someone comments or @mentions you</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer notif-toggle" data-key="notif.comments" checked />
              <div class="w-9 h-5 bg-slate-200 peer-checked:bg-blue-600 rounded-full transition-colors after:content-[''] after:absolute after-top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-4"></div>
            </label>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors">
            <div>
              <p class="text-xs font-bold text-slate-800">Due date reminders</p>
              <p class="text-[10px] text-slate-400 font-medium">Daily digest of tasks due today or overdue</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer notif-toggle" data-key="notif.dueReminders" checked />
              <div class="w-9 h-5 bg-slate-200 peer-checked:bg-blue-600 rounded-full transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-4"></div>
            </label>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors">
            <div>
              <p class="text-xs font-bold text-slate-800">Workspace activity</p>
              <p class="text-[10px] text-slate-400 font-medium">New members, projects, and workspace changes</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer notif-toggle" data-key="notif.workspace" />
              <div class="w-9 h-5 bg-slate-200 peer-checked:bg-blue-600 rounded-full transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-4"></div>
            </label>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors">
            <div>
              <p class="text-xs font-bold text-slate-800">Product updates</p>
              <p class="text-[10px] text-slate-400 font-medium">Occasional feature announcements</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer notif-toggle" data-key="notif.product" />
              <div class="w-9 h-5 bg-slate-200 peer-checked:bg-blue-600 rounded-full transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-4"></div>
            </label>
          </div>
        </div>
      </div>

      <!-- ==================== Preferences ==================== -->
      <div class="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-xs space-y-5">
        <div>
          <h3 class="font-black text-sm text-slate-900">Preferences</h3>
          <p class="text-[11px] text-slate-400 mt-0.5">Defaults applied when you create tasks or view boards</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Default project on new task</label>
            <select id="prefDefaultProject" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 font-semibold focus:outline-none focus:border-blue-600">
              <option value="">— None (choose on create) —</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Default priority</label>
            <select id="prefDefaultPriority" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 font-semibold focus:outline-none focus:border-blue-600">
              <option value="low">🔵 Low</option>
              <option value="medium" selected>🔵 Medium</option>
              <option value="high">🟠 High</option>
              <option value="urgent">🔴 Urgent</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Default view</label>
            <select id="prefDefaultView" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 font-semibold focus:outline-none focus:border-blue-600">
              <option value="kanban" selected>Kanban Board</option>
              <option value="list">List</option>
              <option value="table">Table</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Week starts on</label>
            <select id="prefWeekStart" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 font-semibold focus:outline-none focus:border-blue-600">
              <option value="monday" selected>Monday</option>
              <option value="sunday">Sunday</option>
            </select>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 space-y-1">
          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors">
            <div>
              <p class="text-xs font-bold text-slate-800">Auto-archive completed tasks</p>
              <p class="text-[10px] text-slate-400 font-medium">Hide tasks in "Done" older than 30 days from default views</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer pref-toggle" data-key="pref.autoArchive" />
              <div class="w-9 h-5 bg-slate-200 peer-checked:bg-blue-600 rounded-full transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-4"></div>
            </label>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-slate-50 transition-colors">
            <div>
              <p class="text-xs font-bold text-slate-800">Keyboard shortcuts</p>
              <p class="text-[10px] text-slate-400 font-medium">Enable single-key shortcuts across the app</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer pref-toggle" data-key="pref.shortcuts" checked />
              <div class="w-9 h-5 bg-slate-200 peer-checked:bg-blue-600 rounded-full transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-4"></div>
            </label>
          </div>
        </div>
      </div>

      <!-- ==================== Security ==================== -->
      <div class="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-xs space-y-5">
        <div>
          <h3 class="font-black text-sm text-slate-900">Security</h3>
          <p class="text-[11px] text-slate-400 mt-0.5">Protect your account and review active sessions</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- Change password -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50/60 flex items-start gap-3">
            <div class="w-9 h-9 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-bold text-slate-900">Password</p>
              <p class="text-[10px] text-slate-400 font-medium">Last changed: never</p>
              <button type="button" id="changePasswordBtn" class="mt-2 text-[11px] font-bold text-blue-600 hover:text-blue-700 cursor-pointer">Change password →</button>
            </div>
          </div>

          <!-- 2FA -->
          <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50/60 flex items-start gap-3">
            <div class="w-9 h-9 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M12 3l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V7l8-4z" /></svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-bold text-slate-900">Two-Factor Auth</p>
              <p class="text-[10px] text-slate-400 font-medium">Add an extra layer of security</p>
              <button type="button" id="setup2faBtn" class="mt-2 text-[11px] font-bold text-amber-600 hover:text-amber-700 cursor-pointer">Enable 2FA →</button>
            </div>
          </div>
        </div>

        <!-- Active sessions -->
        <div class="pt-4 border-t border-slate-100">
          <h4 class="text-xs font-bold text-slate-800 mb-2">Active Sessions</h4>
          <div class="space-y-2">
            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-8 h-8 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-center shrink-0">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                </div>
                <div class="min-w-0">
                  <p class="text-xs font-bold text-slate-800 truncate">This device</p>
                  <p class="text-[10px] text-slate-400 font-medium truncate">
                    {Astro.request.headers.get('user-agent')?.slice(0, 60) || 'Current browser session'}
                  </p>
                </div>
              </div>
              <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md shrink-0">
                Current
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== Data & Export ==================== -->
      <div class="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-xs space-y-5">
        <div>
          <h3 class="font-black text-sm text-slate-900">Data & Export</h3>
          <p class="text-[11px] text-slate-400 mt-0.5">Download a copy of your data or clear local settings</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- Export data -->
          <button
            type="button"
            id="exportDataBtn"
            class="p-4 rounded-2xl border border-slate-200 hover:border-blue-300 hover:bg-blue-50/40 transition-all text-left cursor-pointer group"
          >
            <div class="w-9 h-9 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center mb-2 group-hover:bg-blue-100">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            </div>
            <p class="text-xs font-bold text-slate-900">Export My Data</p>
            <p class="text-[10px] text-slate-400 font-medium mt-0.5">Download your tasks, projects, and comments as JSON</p>
          </button>

          <!-- Clear local data -->
          <button
            type="button"
            id="clearLocalBtn"
            class="p-4 rounded-2xl border border-slate-200 hover:border-rose-300 hover:bg-rose-50/40 transition-all text-left cursor-pointer group"
          >
            <div class="w-9 h-9 rounded-xl bg-rose-50 border border-rose-200 flex items-center justify-center mb-2 group-hover:bg-rose-100">
              <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a2 2 0 012-2h2a2 2 0 012 2v3" /></svg>
            </div>
            <p class="text-xs font-bold text-slate-900">Clear Local Data</p>
            <p class="text-[10px] text-slate-400 font-medium mt-0.5">Reset theme, density, and cached preferences on this device</p>
          </button>
        </div>
      </div>

      <!-- ==================== Sign Out Action Card ==================== -->
      <div class="p-6 rounded-3xl bg-white border border-rose-100 shadow-xs flex items-center justify-between">
        <div>
          <h3 class="font-bold text-sm text-slate-900">Sign Out</h3>
          <p class="text-xs text-slate-400 mt-0.5">End your current session on this device</p>
        </div>
        <button
          type="button"
          id="mobileLogoutBtn"
          class="px-4 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-xs border border-rose-200 transition-colors cursor-pointer"
        >
          Sign Out
        </button>
      </div>
    </div>
  </div>

  <!-- ==================== Scripts ==================== -->
  <script>
    // ---------------- Logout ----------------
    const mobileLogoutBtn = document.getElementById('mobileLogoutBtn');
    if (mobileLogoutBtn) {
      mobileLogoutBtn.addEventListener('click', async () => {
        try {
          await fetch('/api/auth/logout', { method: 'POST' });
          window.location.href = '/login';
        } catch {
          window.location.href = '/login';
        }
      });
    }

    // ---------------- Copy User ID ----------------
    const copyBtn = document.getElementById('copyUserIdBtn');
    const userIdInput = document.getElementById('userIdInput') as HTMLInputElement | null;
    if (copyBtn && userIdInput) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(userIdInput.value);
          const original = copyBtn.innerText;
          copyBtn.innerText = '✓ Copied!';
          setTimeout(() => (copyBtn.innerText = original), 2000);
        } catch {
          userIdInput.select();
          document.execCommand('copy');
        }
      });
    }

    // ---------------- Local-storage helper prefs ----------------
    const LS = {
      get<T>(k: string, fallback: T): T {
        try {
          const v = localStorage.getItem(k);
          return v === null ? fallback : (JSON.parse(v) as T);
        } catch {
          return fallback;
        }
      },
      set(k: string, v: unknown) {
        try {
          localStorage.setItem(k, JSON.stringify(v));
        } catch {}
      },
      del(k: string) {
        try {
          localStorage.removeItem(k);
        } catch {}
      },
    };

    // ---------------- Theme picker ----------------
    const themeBtns = document.querySelectorAll<HTMLButtonElement>('.theme-btn');
    const applyTheme = (theme: string) => {
      const root = document.documentElement;
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = theme === 'dark' || (theme === 'system' && systemDark);
      root.classList.toggle('dark', isDark);
      root.dataset.theme = theme;
      // reflect on UI
      themeBtns.forEach((b) => {
        const active = b.dataset.theme === theme;
        b.classList.toggle('border-blue-500', active);
        b.classList.toggle('bg-blue-50/40', active);
        b.classList.toggle('border-slate-200', !active);
      });
    };
    const savedTheme = LS.get('pref.theme', 'system');
    applyTheme(savedTheme);
    themeBtns.forEach((b) => {
      b.addEventListener('click', () => {
        const theme = b.dataset.theme || 'system';
        LS.set('pref.theme', theme);
        applyTheme(theme);
      });
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (LS.get('pref.theme', 'system') === 'system') applyTheme('system');
    });

    // ---------------- Accent color ----------------
    const accentBtns = document.querySelectorAll<HTMLButtonElement>('.accent-btn');
    const applyAccent = (color: string) => {
      document.documentElement.style.setProperty('--accent', color);
      accentBtns.forEach((b) => {
        const active = b.dataset.accent === color;
        b.style.outline = active ? `2px solid ${color}` : 'none';
        b.style.outlineOffset = '2px';
      });
    };
    const savedAccent = LS.get('pref.accent', '#2563eb');
    applyAccent(savedAccent);
    accentBtns.forEach((b) => {
      b.addEventListener('click', () => {
        const c = b.dataset.accent || '#2563eb';
        LS.set('pref.accent', c);
        applyAccent(c);
      });
    });

    // ---------------- Density ----------------
    const densityBtns = document.querySelectorAll<HTMLButtonElement>('.density-btn');
    const applyDensity = (density: string) => {
      document.documentElement.dataset.density = density;
      densityBtns.forEach((b) => {
        const active = b.dataset.density === density;
        b.classList.toggle('bg-white', active);
        b.classList.toggle('text-blue-600', active);
        b.classList.toggle('shadow-xs', active);
        b.classList.toggle('text-slate-600', !active);
      });
    };
    const savedDensity = LS.get('pref.density', 'cozy');
    applyDensity(savedDensity);
    densityBtns.forEach((b) => {
      b.addEventListener('click', () => {
        const d = b.dataset.density || 'cozy';
        LS.set('pref.density', d);
        applyDensity(d);
      });
    });

    // ---------------- Toggle switches (notifications + preferences) ----------------
    const allToggles = document.querySelectorAll<HTMLInputElement>('.notif-toggle, .pref-toggle');
    allToggles.forEach((input) => {
      const key = input.dataset.key || '';
      input.checked = LS.get<boolean>(key, input.checked);
      input.addEventListener('change', () => LS.set(key, input.checked));
    });

    // ---------------- Dropdown preferences ----------------
    const bindSelect = (id: string, key: string, def: string) => {
      const el = document.getElementById(id) as HTMLSelectElement | null;
      if (!el) return;
      const saved = LS.get<string>(key, def);
      el.value = saved;
      el.addEventListener('change', () => LS.set(key, el.value));
    };
    bindSelect('prefDefaultPriority', 'pref.defaultPriority', 'medium');
    bindSelect('prefDefaultView', 'pref.defaultView', 'kanban');
    bindSelect('prefWeekStart', 'pref.weekStart', 'monday');

    // ---------------- Populate project dropdown ----------------
    (async () => {
      const sel = document.getElementById('prefDefaultProject') as HTMLSelectElement | null;
      if (!sel) return;
      try {
        const res = await fetch('/api/projects');
        const data: any = await res.json();
        const projects: any[] = data.projects || [];
        projects.forEach((p) => {
          const opt = document.createElement('option');
          opt.value = p.id;
          opt.textContent = `📁 ${p.name}`;
          sel.appendChild(opt);
        });
        sel.value = LS.get<string>('pref.defaultProject', '');
        sel.addEventListener('change', () => LS.set('pref.defaultProject', sel.value));
      } catch {}
    })();

    // ---------------- Security actions ----------------
    document.getElementById('changePasswordBtn')?.addEventListener('click', () => {
      alert('Password change flow would open here (connect to /api/auth/change-password).');
    });
    document.getElementById('setup2faBtn')?.addEventListener('click', () => {
      alert('2FA setup flow would open here (connect to your TOTP provider).');
    });

    // ---------------- Export data ----------------
    document.getElementById('exportDataBtn')?.addEventListener('click', async () => {
      try {
        const [tasksRes, projectsRes] = await Promise.all([
          fetch('/api/tasks'),
          fetch('/api/projects'),
        ]);
        const tasksJson: any = await tasksRes.json();
        const projectsJson: any = await projectsRes.json();
        const payload = {
          exportedAt: new Date().toISOString(),
          tasks: tasksJson.tasks || [],
          projects: projectsJson.projects || [],
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `taskflow-export-${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
      } catch {
        alert('Export failed. Please try again.');
      }
    });

    // ---------------- Clear local data ----------------
    document.getElementById('clearLocalBtn')?.addEventListener('click', () => {
      if (!confirm('Clear all locally saved preferences on this device? This does not affect your account.')) return;
      const keys = [
        'pref.theme',
        'pref.accent',
        'pref.density',
        'pref.defaultProject',
        'pref.defaultPriority',
        'pref.defaultView',
        'pref.weekStart',
        'pref.autoArchive',
        'pref.shortcuts',
        'notif.taskAssigned',
        'notif.comments',
        'notif.dueReminders',
        'notif.workspace',
        'notif.product',
      ];
      keys.forEach((k) => LS.del(k));
      location.reload();
    });
  </script>
</Layout>

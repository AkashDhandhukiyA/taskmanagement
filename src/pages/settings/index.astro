---
import Layout from '../../layouts/Layout.astro';
import SettingsManager from '../../components/settings/SettingsManager';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}
---

<Layout title="Account & Security Settings - TaskFlow" activePath="/settings">
  <div class="max-w-7xl mx-auto py-4 sm:py-6 lg:py-8 px-3 sm:px-6 lg:px-8">
    <SettingsManager
      client:load
      user={{
        id: user.id || (user as any).userId,
        name: user.name,
        email: user.email,
        avatar: (user as any).avatar,
      }}
    />
  </div>
</Layout>


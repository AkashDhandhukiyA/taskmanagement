---
import '../styles/global.css';
import HeaderSearchNotifications from '../components/layout/HeaderSearchNotifications';

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const { title = 'TaskFlow - Modern Project & Company Management', description = 'Modern agile task and company management on Cloudflare D1', activePath = '' } = Astro.props;
const rawUser = Astro.locals.user;
const user: any = rawUser;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function() {
        try {
          const theme = localStorage.getItem('taskflow_theme') || 'light';
          const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          const accent = localStorage.getItem('taskflow_accent');
          if (accent) {
            document.documentElement.style.setProperty('--accent-color', accent);
          }
          const density = localStorage.getItem('taskflow_density') || 'compact';
          document.documentElement.setAttribute('data-density', density);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-[#f8faff] text-slate-900 min-h-screen flex flex-col font-['Plus_Jakarta_Sans',sans-serif] overflow-x-hidden">
    {user ? (
      <div class="flex min-h-screen min-w-0 max-w-full">
        {/* ============ DESKTOP SIDEBAR (md and up) ============ */}
        <aside class="hidden md:flex w-60 lg:w-64 xl:w-72 bg-white border-r border-slate-200/80 flex-col fixed inset-y-0 z-30 shadow-xs">
          {/* Logo + Company Switcher */}
          <div class="relative border-b border-slate-100" id="wsSwitcherWrap">
            <button
              id="wsSwitcherBtn"
              type="button"
              class="w-full h-16 flex items-center px-4 lg:px-5 gap-3 hover:bg-slate-50/70 transition-colors cursor-pointer text-left"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-label="Switch company"
            >
              <div class="w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center text-white font-bold shadow-sm shadow-blue-500/30 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>

              <div class="flex items-center gap-1.5 flex-1 min-w-0">
                <span id="wsSwitcherName" class="font-bold text-sm text-slate-900 truncate">Loading...</span>
                <span id="wsSwitcherTz" class="hidden xl:inline-block px-1.5 py-0.5 rounded-md bg-slate-100 text-[9px] font-mono font-semibold text-slate-600 border border-slate-200 shrink-0 truncate max-w-[80px]">
                  UTC
                </span>
              </div>

              <svg
                id="wsSwitcherChevron"
                class="w-3.5 h-3.5 text-slate-400 shrink-0 transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            {/* Desktop dropdown */}
            <div
              id="wsSwitcherMenu"
              class="hidden absolute left-2 right-2 top-full mt-1 bg-white border border-slate-200 rounded-2xl shadow-xl shadow-slate-900/10 py-1.5 z-50 max-h-[70vh] overflow-y-auto"
              role="listbox"
            >
              <div class="px-3 py-2 border-b border-slate-100 sticky top-0 bg-white rounded-t-2xl flex items-center justify-between">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Switch Company</p>
                <a href="/company/create" class="text-[10px] font-bold text-blue-600 hover:text-blue-700">+ New</a>
              </div>
              <div id="wsSwitcherList" class="py-1"></div>
              <div class="border-t border-slate-100 mt-1 pt-1 space-y-1">
                <a
                  href="/company"
                  class="flex items-center gap-2 px-3 py-2 text-xs font-bold text-blue-600 hover:bg-blue-50 rounded-xl mx-1 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                  Manage Company & Team
                </a>
              </div>
            </div>
          </div>

          {/* Navigation Links */}
          <nav class="flex-1 px-3 py-4 lg:py-5 space-y-1 overflow-y-auto">
            <div class="px-3 pb-2 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Company</div>

            <a
              href="/dashboard"
              class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all ${
                activePath === '/dashboard'
                  ? 'bg-blue-50 text-blue-600 border border-blue-100 shadow-2xs'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
              }`}
            >
              <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M4 4h6v6H4V4zm10 0h6v6h-6V4zM4 14h6v6H4v-6zm10 0h6v6h-6v-6z" /></svg>
              <span class="truncate">Dashboard</span>
            </a>

            <a
              href="/tasks"
              class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all ${
                activePath === '/tasks'
                  ? 'bg-blue-50 text-blue-600 border border-blue-100 shadow-2xs'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
              }`}
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
              <span class="truncate">Tasks & Kanban</span>
            </a>

            <a
              href="/projects"
              class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all ${
                activePath === '/projects'
                  ? 'bg-blue-50 text-blue-600 border border-blue-100 shadow-2xs'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
              }`}
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
              <span class="truncate">Projects</span>
            </a>

            <a
              href="/company"
              class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all ${
                activePath === '/company' || activePath === '/workspace'
                  ? 'bg-blue-50 text-blue-600 border border-blue-100 shadow-2xs'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
              }`}
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
              <span class="truncate">Company & Team</span>
            </a>

            <a
              href="/audit-log"
              class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all ${
                activePath === '/audit-log'
                  ? 'bg-blue-50 text-blue-600 border border-blue-100 shadow-2xs'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
              }`}
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
              <span class="truncate">Audit Log</span>
            </a>

            <div class="pt-5 px-3 pb-2 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Account</div>

            <a
              href="/settings"
              class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all ${
                activePath === '/settings'
                  ? 'bg-blue-50 text-blue-600 border border-blue-100 shadow-2xs'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
              }`}
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <span class="truncate">Settings</span>
            </a>
          </nav>

          {/* Desktop User Bottom */}
          <div class="p-3 lg:p-4 border-t border-slate-100 bg-slate-50/60">
            <div class="flex items-center gap-3">
              <img
                src={user.avatar || `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(user.name || 'Maya')}`}
                alt="Profile"
                class="w-9 h-9 rounded-full object-cover ring-2 ring-white shrink-0"
              />
              <div class="flex-1 min-w-0">
                <p class="text-xs font-bold text-slate-800 truncate">{user.name}</p>
                <p class="text-[10px] text-slate-400 truncate">{user.email}</p>
              </div>
              <button
                id="logoutBtn"
                title="Logout"
                class="p-1.5 text-slate-400 hover:text-rose-500 rounded-lg transition-colors cursor-pointer shrink-0"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
              </button>
            </div>
          </div>
        </aside>

        {/* ============ MAIN BODY ============ */}
        <div class="flex-1 md:ml-60 lg:ml-64 xl:ml-72 flex flex-col min-h-screen min-w-0 max-w-full overflow-x-hidden">
          {/* Top Navbar */}
          <header class="h-16 bg-white/90 backdrop-blur-md border-b border-slate-100 sticky top-0 z-20 flex items-center justify-between gap-2 px-3 sm:px-4 md:px-6 lg:px-8">
            {/* Mobile / Tablet — Company switcher */}
            <div class="flex items-center gap-2 relative min-w-0 flex-1 md:hidden" id="wsMobileWrap">
              <button
                id="wsMobileBtn"
                type="button"
                class="flex items-center gap-2 cursor-pointer text-left min-w-0 max-w-full active:scale-[0.98] transition-transform"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-label="Switch company"
              >
                <div class="w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center text-white font-bold shadow-sm shadow-blue-500/30 shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
                <div class="flex items-center gap-1 min-w-0">
                  <span id="wsMobileName" class="font-bold text-sm text-slate-900 truncate max-w-[110px] sm:max-w-[160px]">
                    Loading...
                  </span>
                  <svg
                    id="wsMobileChevron"
                    class="w-3 h-3 text-slate-400 shrink-0 transition-transform duration-200"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </button>

              {/* Mobile dropdown */}
              <div
                id="wsMobileMenu"
                class="hidden absolute left-0 top-full mt-2 w-[min(calc(100vw-1.5rem),17rem)] bg-white border border-slate-200 rounded-2xl shadow-xl shadow-slate-900/10 py-1.5 z-50 max-h-[70vh] overflow-y-auto"
                role="listbox"
              >
                <div class="px-3 py-2 border-b border-slate-100 sticky top-0 bg-white rounded-t-2xl flex items-center justify-between">
                  <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Switch Company</p>
                  <a href="/company/create" class="text-[10px] font-bold text-blue-600">+ New</a>
                </div>
                <div id="wsMobileList" class="py-1"></div>
                <div class="border-t border-slate-100 mt-1 pt-1">
                  <a
                    href="/company"
                    class="flex items-center gap-2 px-3 py-2 text-xs font-bold text-blue-600 hover:bg-blue-50 rounded-xl mx-1 transition-colors"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    Manage Company & Team
                  </a>
                </div>
              </div>
            </div>

            {/* Search + Notifications Island */}
            <div class="flex items-center ml-auto min-w-0">
              <HeaderSearchNotifications client:load user={user} />
            </div>
          </header>

          {/* Page content */}
          <main class="flex-1 pb-28 md:pb-6 lg:pb-8 min-w-0 max-w-full overflow-x-hidden">
            <slot />
          </main>

          {/* ============ MOBILE BOTTOM NAV (phones + small tablets) ============ */}
          <nav class="md:hidden fixed bottom-0 inset-x-0 z-30 bg-white/95 backdrop-blur-lg border-t border-slate-200/90 flex items-center justify-around px-1 sm:px-2 py-2 shadow-lg shadow-slate-900/5 pb-[max(0.6rem,env(safe-area-inset-bottom))]">
            <a
              href="/dashboard"
              class={`flex flex-col items-center justify-center gap-1 px-2 sm:px-3 py-1.5 rounded-2xl transition-all active:scale-95 min-w-[56px] ${
                activePath === '/dashboard' ? 'text-blue-600 font-bold bg-blue-50/80 shadow-2xs' : 'text-slate-400 hover:text-slate-700'
              }`}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M4 4h6v6H4V4zm10 0h6v6h-6V4zM4 14h6v6H4v-6zm10 0h6v6h-6v-6z" /></svg>
              <span class="text-[10px]">Dashboard</span>
            </a>

            <a
              href="/tasks"
              class={`flex flex-col items-center justify-center gap-1 px-2 sm:px-3 py-1.5 rounded-2xl transition-all active:scale-95 min-w-[56px] ${
                activePath === '/tasks' ? 'text-blue-600 font-bold bg-blue-50/80 shadow-2xs' : 'text-slate-400 hover:text-slate-700'
              }`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
              <span class="text-[10px]">Tasks</span>
            </a>

            <a
              href="/projects"
              class={`flex flex-col items-center justify-center gap-1 px-2 sm:px-3 py-1.5 rounded-2xl transition-all active:scale-95 min-w-[56px] ${
                activePath === '/projects' ? 'text-blue-600 font-bold bg-blue-50/80 shadow-2xs' : 'text-slate-400 hover:text-slate-700'
              }`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
              <span class="text-[10px]">Projects</span>
            </a>

            <a
              href="/company"
              class={`flex flex-col items-center justify-center gap-1 px-2 sm:px-3 py-1.5 rounded-2xl transition-all active:scale-95 min-w-[56px] ${
                activePath === '/company' || activePath === '/workspace' ? 'text-blue-600 font-bold bg-blue-50/80 shadow-2xs' : 'text-slate-400 hover:text-slate-700'
              }`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
              <span class="text-[10px]">Company</span>
            </a>

            <a
              href="/audit-log"
              class={`flex flex-col items-center justify-center gap-1 px-2 sm:px-3 py-1.5 rounded-2xl transition-all active:scale-95 min-w-[56px] ${
                activePath === '/audit-log' ? 'text-blue-600 font-bold bg-blue-50/80 shadow-2xs' : 'text-slate-400 hover:text-slate-700'
              }`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
              <span class="text-[10px]">Audit</span>
            </a>

            <a
              href="/settings"
              class={`flex flex-col items-center justify-center gap-1 px-2 sm:px-3 py-1.5 rounded-2xl transition-all active:scale-95 min-w-[56px] ${
                activePath === '/settings' ? 'text-blue-600 font-bold bg-blue-50/80 shadow-2xs' : 'text-slate-400 hover:text-slate-700'
              }`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <span class="text-[10px]">Settings</span>
            </a>
          </nav>
        </div>
      </div>
    ) : (
      /* ============ GUEST LAYOUT ============ */
      <div class="min-h-screen flex flex-col bg-[#f8faff]">
        <header class="h-16 border-b border-slate-100 bg-white/90 backdrop-blur-md px-4 sm:px-6 md:px-12 flex items-center justify-between sticky top-0 z-20 shadow-2xs">
          <a href="/" class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center text-white font-bold shadow-sm shadow-blue-500/30">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </div>
            <span class="font-extrabold text-base tracking-tight text-slate-900">TaskFlow</span>
          </a>

          <div class="flex items-center gap-2 sm:gap-3">
            <a href="/login" class="text-xs font-bold text-slate-600 hover:text-slate-900 px-2 sm:px-3 py-2 rounded-xl transition-colors">Sign In</a>
            <a href="/register" class="px-3 sm:px-4 py-2 text-xs font-bold rounded-xl bg-blue-600 hover:bg-blue-700 text-white shadow-sm shadow-blue-600/30 transition-all">Get Started</a>
          </div>
        </header>

        <main class="flex-1">
          <slot />
        </main>
      </div>
    )}

    <script>
      // ---------- Logout ----------
      const logoutBtn = document.getElementById('logoutBtn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          try {
            await fetch('/api/auth/logout', { method: 'POST' });
            window.location.href = '/login';
          } catch (e) {
            window.location.href = '/login';
          }
        });
      }

      // ---------- Company Switcher ----------
      (function () {
        const STORAGE_KEY = 'activeCompanyId';
        const LEGACY_STORAGE_KEY = 'activeWorkspaceId';

        const wrap = document.getElementById('wsSwitcherWrap');
        const btn = document.getElementById('wsSwitcherBtn');
        const menu = document.getElementById('wsSwitcherMenu');
        const list = document.getElementById('wsSwitcherList');
        const nameEl = document.getElementById('wsSwitcherName');
        const tzEl = document.getElementById('wsSwitcherTz');
        const chevron = document.getElementById('wsSwitcherChevron');

        const mobileWrap = document.getElementById('wsMobileWrap');
        const mobileBtn = document.getElementById('wsMobileBtn');
        const mobileMenu = document.getElementById('wsMobileMenu');
        const mobileList = document.getElementById('wsMobileList');
        const mobileName = document.getElementById('wsMobileName');
        const mobileChevron = document.getElementById('wsMobileChevron');

        if (!btn && !mobileBtn) return;

        let companies = [];
        let activeId = localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_STORAGE_KEY) || '';

        function setActiveDisplay(company) {
          const name = company?.name || 'Company';
          if (nameEl) nameEl.textContent = name;
          if (mobileName) mobileName.textContent = name;
          if (tzEl) tzEl.textContent = company?.timezone || 'UTC';
        }

        function renderList(container) {
          if (!container) return;
          container.innerHTML = '';

          if (!companies.length) {
            const empty = document.createElement('div');
            empty.className = 'px-3 py-2 text-xs text-slate-400';
            empty.textContent = 'No companies found';
            container.appendChild(empty);
            return;
          }

          companies.forEach((comp) => {
            const isActive = comp.id === activeId;
            const el = document.createElement('button');
            el.type = 'button';
            el.className =
              'w-full flex items-center justify-between gap-2 px-3 py-2 text-left text-xs rounded-xl transition-colors cursor-pointer ' +
              (isActive
                ? 'bg-blue-50 text-blue-700 font-bold'
                : 'text-slate-700 hover:bg-slate-50 font-medium');
            el.innerHTML =
              '<div class="flex items-center gap-2 min-w-0">' +
                '<div class="w-6 h-6 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-[10px] font-black shrink-0">' +
                  (comp.name ? comp.name.charAt(0).toUpperCase() : 'C') +
                '</div>' +
                '<div class="min-w-0">' +
                  '<p class="truncate">' + comp.name + '</p>' +
                  '<p class="text-[9px] text-slate-400 capitalize leading-none mt-0.5 font-mono">' +
                    (comp.timezone || 'UTC') + ' • ' + (comp.role || 'member') +
                  '</p>' +
                '</div>' +
              '</div>' +
              (isActive
                ? '<svg class="w-3.5 h-3.5 text-blue-600 shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>'
                : '');

            el.addEventListener('click', () => selectCompany(comp.id));
            container.appendChild(el);
          });
        }

        function selectCompany(id) {
          activeId = id;
          localStorage.setItem(STORAGE_KEY, id);
          localStorage.setItem(LEGACY_STORAGE_KEY, id);
          const comp = companies.find((c) => c.id === id);
          setActiveDisplay(comp);
          renderList(list);
          renderList(mobileList);
          closeMenus();

          window.dispatchEvent(
            new CustomEvent('companyChanged', { detail: { companyId: id, company: comp } })
          );
          window.dispatchEvent(
            new CustomEvent('workspaceChanged', { detail: { workspaceId: id, workspace: comp } })
          );
        }

        function openMenu(m, c) {
          closeMenus();
          m?.classList.remove('hidden');
          if (c) c.style.transform = 'rotate(180deg)';
          if (m === menu && btn) btn.setAttribute('aria-expanded', 'true');
          if (m === mobileMenu && mobileBtn) mobileBtn.setAttribute('aria-expanded', 'true');
        }

        function closeMenus() {
          menu?.classList.add('hidden');
          mobileMenu?.classList.add('hidden');
          if (chevron) chevron.style.transform = 'rotate(0deg)';
          if (mobileChevron) mobileChevron.style.transform = 'rotate(0deg)';
          if (btn) btn.setAttribute('aria-expanded', 'false');
          if (mobileBtn) mobileBtn.setAttribute('aria-expanded', 'false');
        }

        btn?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (menu?.classList.contains('hidden')) openMenu(menu, chevron);
          else closeMenus();
        });

        mobileBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (mobileMenu?.classList.contains('hidden')) openMenu(mobileMenu, mobileChevron);
          else closeMenus();
        });

        document.addEventListener('click', (e) => {
          const t = e.target;
          if ((wrap && wrap.contains(t)) || (mobileWrap && mobileWrap.contains(t))) return;
          closeMenus();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeMenus();
        });

        let rt;
        window.addEventListener('resize', () => {
          clearTimeout(rt);
          rt = setTimeout(closeMenus, 120);
        });

        // Initial load
        (async function loadCompanies() {
          try {
            const res = await fetch('/api/companies');
            const data = await res.json();
            companies = data.companies || [];

            if (!companies.length) {
              setActiveDisplay(null);
              renderList(list);
              renderList(mobileList);

              // If logged-in user has 0 companies, redirect them to create one (unless already on create page)
              if (window.location.pathname !== '/company/create' && !window.location.pathname.startsWith('/api/')) {
                window.location.href = '/company/create';
              }
              return;
            }

            if (!activeId || !companies.some((c) => c.id === activeId)) {
              activeId = companies[0].id;
              localStorage.setItem(STORAGE_KEY, activeId);
              localStorage.setItem(LEGACY_STORAGE_KEY, activeId);
            }

            setActiveDisplay(companies.find((c) => c.id === activeId));
            renderList(list);
            renderList(mobileList);
          } catch (err) {
            console.error('Failed to load companies', err);
          }
        })();
      })();
    </script>
  </body>
</html>

